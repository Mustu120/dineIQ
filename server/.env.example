SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Deployed frontend URL, e.g. https://dineiq.vercel.app -- restricts which
# site can call this API. Leave unset locally to allow any origin.
CLIENT_URL=

# A SEPARATE key from the client's VITE_GOOGLE_MAPS_API_KEY -- this one is
# used server-to-server (no browser involved), so it should NOT have an
# HTTP-referrer restriction, and must never be exposed to the frontend.
# Create it at https://console.cloud.google.com/google/maps-apis/credentials,
# then under "API restrictions" limit it to just "Places API (New)".
# Billed per request (see server/utils/googlePlaces.js for how sparingly
# it's actually called) -- covered by Google's free trial credit / the
# ongoing $200/mo credit for light use.
GOOGLE_PLACES_API_KEY=your-google-places-api-key
